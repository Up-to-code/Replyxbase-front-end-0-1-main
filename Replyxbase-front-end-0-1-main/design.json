{
    "meta": {
      "name": "eCommy-dashboard-design",
      "version": "1.0",
      "description": "High-level design system tokens and component guidelines to reproduce the attached dashboard look.",
      "author_role": "Creative Director (AI-friendly specs)"
    },
    "principles": [
      "Clarity first: prioritize information hierarchy and readable data display.",
      "Soft minimalism: clean white surfaces, restrained accents and subtle shadows.",
      "Calm contrast: muted greys with a single digital blue accent to guide attention.",
      "Modular cards: UI built from composable, reusable cards and rows.",
      "Economy of motion: micro-animations for hover/focus only, nothing distracting.",
      "Accessible by default: sufficient contrast, clear focus states, and predictable interactions."
    ],
    "tokens": {
      "colors": {
        "surface": "#FFFFFF",
        "surface-muted": "#F6F7F9",
        "bg": "#E8ECEF",
        "panel": "#FFFFFF",
        "panel-border": "#E6E9EC",
        "text-primary": "#1F2933",
        "text-secondary": "#6B7280",
        "text-muted": "#9AA0A6",
        "muted-dark": "#2B2F33",
        "sidebar-bg": "#222427",
        "accent-blue": "#2D85FF",
        "accent-blue-2": "#EAF4FF",
        "success": "#16A34A",
        "warning": "#F59E0B",
        "danger": "#EF4444",
        "chip-bg": "#F3F6F9",
        "shadow-1": "rgba(17,24,39,0.04)",
        "shadow-2": "rgba(17,24,39,0.08)",
        "glass": "rgba(255,255,255,0.6)"
      },
      "typography": {
        "font-family-sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial",
        "font-size-base": 16,
        "scale": {
          "xs": 12,
          "sm": 14,
          "base": 16,
          "lg": 18,
          "xl": 20,
          "2xl": 24,
          "3xl": 32,
          "4xl": 40
        },
        "weights": {
          "regular": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        },
        "line-heights": {
          "tight": 1.1,
          "normal": 1.4,
          "relaxed": 1.6
        }
      },
      "spacing": {
        "unit": 4,
        "scale": {
          "xs": 4,
          "sm": 8,
          "md": 12,
          "lg": 16,
          "xl": 24,
          "2xl": 32,
          "3xl": 48
        }
      },
      "radii": {
        "none": 0,
        "sm": 6,
        "md": 10,
        "lg": 16,
        "round": 9999
      },
      "borders": {
        "width-1": "1px",
        "width-2": "2px",
        "color": "var(--panel-border)"
      },
      "shadows": {
        "card": "0 6px 18px var(--shadow-1)",
        "card-strong": "0 10px 30px var(--shadow-2)",
        "inner": "inset 0 1px 0 rgba(255,255,255,0.6)"
      },
      "grid": {
        "columns": 12,
        "gutter": 24,
        "breakpoints": {
          "sm": 640,
          "md": 900,
          "lg": 1200,
          "xl": 1600
        }
      }
    },
    "layout": {
      "canvas": {
        "background": "var(--bg)",
        "page-max-width": 1400,
        "page-padding": "var(--spacing-lg)"
      },
      "sidebar": {
        "width": 260,
        "collapsed-width": 72,
        "background": "var(--sidebar-bg)",
        "text-color": "#FFFFFF",
        "padding-vertical": "var(--spacing-2xl)",
        "logo-area-height": 56,
        "nav-item-height": 48,
        "icon-size": 18,
        "divider": "1px solid rgba(255,255,255,0.04)"
      },
      "topbar": {
        "height": 64,
        "background": "transparent",
        "padding-horizontal": "var(--spacing-lg)",
        "search-width": 520,
        "avatar-size": 36
      }
    },
    "components": {
      "card": {
        "background": "var(--panel)",
        "border-radius": "var(--radii-md)",
        "border": "var(--borders-width-1) solid var(--panel-border)",
        "padding": "var(--spacing-lg)",
        "box-shadow": "var(--shadows-card)"
      },
      "kpi": {
        "value-size": "2xl semibold",
        "trend-color-positive": "success",
        "trend-color-negative": "danger"
      },
      "button": {
        "border-radius": "var(--radii-sm)",
        "height": 36,
        "primary-bg": "linear-gradient(180deg, var(--accent-blue), #266DFF)",
        "primary-color": "#FFFFFF"
      },
      "input": {
        "height": 40,
        "padding": "8px 12px",
        "border": "1px solid var(--panel-border)"
      },
      "table": {
        "row-height": 56,
        "header-weight": 600,
        "hover-bg": "var(--surface-muted)"
      },
      "chart": {
        "accent-color": "var(--accent-blue)",
        "minimal-grid": true
      },
      "avatar": {
        "size": 36,
        "border": "2px solid var(--panel-border)"
      },
      "badge": {
        "size-sm": {
          "padding": "4px 8px",
          "radius": "999px"
        }
      },
      "date-picker": {
        "compact": true,
        "selected-bg": "var(--accent-blue)"
      }
    },
    "accessibility": {
      "contrast": "AA+ recommended",
      "focus-ring": "visible 3–4px soft blue glow"
    },
    "motion": {
      "duration-default": "200ms",
      "hover-elevation": "translateY(-4px) + stronger shadow"
    }
  }
  